# Copy to .env and fill in.

# Your Jellyfin server, as Clip Show (the container) can reach it. Required.
JELLYFIN_URL=http://jellyfin:8096
# How people's browsers reach Jellyfin, for "Open in Jellyfin" (leave empty if the same).
JELLYFIN_PUBLIC_URL=

# The folder that holds your shows and movies on this machine (mounted read-only at /media).
MEDIA_DIR=/srv/media
# Where Clip Show keeps its indexes and rendered clips (several GB per show).
DATA_DIR=./data

# Port for the web app.
PORT=8000
# optional: anyone can search, signing in adds "Open in Jellyfin". required: sign in to use Clip Show.
CLIPSHOW_SIGNIN=optional

# Share links are served on their own port, which serves nothing else, so you can publish just that one
# (e.g. with Tailscale Funnel) and keep the rest private. SHARE_URL is its public address.
SHARE_PORT=8001
SHARE_URL=

# A shared secret the indexing workers use to talk to the web app. Make one with:  openssl rand -hex 32
WORKER_TOKEN=

# Worker image: cpu, cuda (NVIDIA) or rocm (AMD). See compose.yaml for GPU setup.
WORKER_FLAVOR=cpu
CLIPSHOW_WORKERS=4

# Only for compose.worker.yaml (a worker on another machine): where the web app is.
# CLIPSHOW_SERVER=http://nas.local:8000
